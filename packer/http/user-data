#cloud-config
autoinstall:
  version: 1
  locale: en_US
  keyboard:
    layout: us
  identity:
    hostname: ubuntu-server
    username: ubuntu
    password: "$y$j9T$ErTgeZ0aH0sZdDTbk6C0H0$XgqVXsTdx5cxe3E/C92vVRNbj4kbarN1/pjsV6Lm4TB"
  ssh:
    install-server: true
    allow-pw: true
    ssh_quiet_keygen: true
    authorized_keys:
      - "ssh-rsa  root@pve"
  network:
    version: 2
    ethernets:
      all-en:
        match:
          name: "en*"
        dhcp4: true
        dhcp6: false
      all-eth:
        match:
          name: "eth*"
        dhcp4: true
        dhcp6: false
  packages:
    - qemu-guest-agent
    - sudo
    - openssh-server
    - net-tools
    - perl
    - open-iscsi
    - curl
    - vim
    - ifupdown
    - zip
    - unzip
    - gnupg2
    - software-properties-common
    - apt-transport-https
    - ca-certificates
    - lsb-release
    - python3-pip
    - jq
    - cloud-init
  storage:
    layout:
      name: direct
    swap:
      size: 0
  user-data:
    package_upgrade: false
    timezone: UTC
    disable_root: false
  late-commands:
    - echo 'ubuntu ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/ubuntu
    - chmod 440 /target/etc/sudoers.d/ubuntu
    - |
      if [ -d /sys/firmware/efi ]; then
        apt-get install -y efibootmgr
        efibootmgr -o $(efibootmgr | perl -n -e '/Boot(.+)\* Ubuntu/ && print $1')
      fi
  # Force non-interactive installation
  interactive-sections: [] 
